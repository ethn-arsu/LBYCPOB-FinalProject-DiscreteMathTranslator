<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.discretemathtranslator.controller.MainController"
            prefWidth="1000" prefHeight="750" stylesheets="/css/styles.css">

    <!--Header -->
    <top>
        <VBox>
            <padding>
                <Insets top="25" right="35" left="35" bottom="20"/>
            </padding>
            <Label text="Discrete Math Translator"
                   styleClass="title-label"/>
            <Label text="Translates English statements to discrete mathematical notations"
                   styleClass="subtitle-label"/>
        </VBox>
    </top>

    <!-- Main Stage -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">
            <VBox spacing="18">
                <padding>
                    <Insets top="5" right="35" left="35" bottom="25"/>
                </padding>

                <!-- Input Section -->
                <VBox spacing="8">
                    <Label text="English Message" styleClass="section-label"/>
                    <TextField fx:id="inputField"
                               promptText="Enter an English statement here"
                               prefHeight="42"
                               onAction="#handleTranslation"/>

                    <HBox spacing="10">
                        <Button fx:id="translateButton"
                                text="Translate"
                                prefWidth="120"
                                onAction="#handleTranslation"/>

                        <Button fx:id="clearButton"
                                text="Clear"
                                prefWidth="100"
                                onAction="#handleClear"/>
                    </HBox>
                    <Label fx:id="statusLabel"
                           text=""
                           wrapText="true"/>
                </VBox>

                <Separator/>

                <!--Results Display-->
                <VBox spacing="8">
                    <Label text="Translation"
                           styleClass="section-label"/>
                    <TextArea fx:id="translationLabel"
                           promptText="Translation will appear here"
                           wrapText="true"
                           styleClass="notation-label"/>
                </VBox>

                <!--Explanation-->
                <VBox spacing="8">
                    <Label text="Explanation"
                           styleClass="section-label"/>
                    <TextArea fx:id="explanationLabel"
                              editable="false"
                              wrapText="true"
                              prefRowCount="5"
                              promptText="An explanation of the translation appears here"
                              styleClass="explanation-area"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>
<bottom>
    <HBox alignment="CENTER">
        <padding>
            <Insets top="10" left="20" right="20" bottom="15"/>
        </padding>

        <Label text="Arsua • Mauricio • Robes"/>
    </HBox>
</bottom>



</BorderPane>